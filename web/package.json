{
  "name": "frozen-throne-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-no-mock.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "lint:api": "redocly lint --config ../api/redocly.yaml ../api/openapi.yaml",
    "dev:mock": "VITE_MOCK=1 vite",
    "build:mock": "tsc -b && VITE_MOCK=1 vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@redocly/cli": "^2.73.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^29.1.1",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
